{
  "name": "eventyoshi",
  "description": "Allows several event emitters to be listened and emitted through a single one.",
  "keywords": [
    "event",
    "emitter",
    "eventemitter",
    "router",
    "proxy"
  ],
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/node-eventyoshi.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit && npm run test:package",
    "test:unit": "mocha --require ts-node/register --ignore test/export-test.ts test/*-test.ts",
    "test:package": "mocha --require ts-node/register test/export-test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/sinon": "^22.0.2",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "license": "MIT"
}
